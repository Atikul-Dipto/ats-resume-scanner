# Copy to backend/.env for local development. Every value has a working
# default; production must set at least ENVIRONMENT, JWT_SECRET,
# DATABASE_URL and ALLOWED_ORIGINS.

ENVIRONMENT=development

# SQLite by default. Production: a Postgres URL (Neon/Supabase/Render all
# work as-is; postgres:// is rewritten to the psycopg3 driver automatically).
DATABASE_URL=sqlite:///./data/app.db

# Optional. Leave unset for a single instance (in-memory cache + rate limits).
# Set before running more than one instance so they share state.
# REDIS_URL=redis://localhost:6379/0

# Required in production: a random 32+ character string.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-secret-change-me-before-deploying
JWT_EXPIRE_MINUTES=10080

# Comma-separated origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173

# Abuse limits (per client IP): "<count>/<second|minute|hour>"
RATE_LIMIT_ANALYZE=12/minute
RATE_LIMIT_BUILDER=90/minute
RATE_LIMIT_EXPORT=20/minute
RATE_LIMIT_JOBS=20/minute
RATE_LIMIT_AUTH=10/minute

MAX_UPLOAD_MB=5
MAX_PDF_PAGES=10
PARSE_CONCURRENCY=4
MAX_RESUMES_PER_USER=25

# Job search
JOBS_CACHE_TTL_SECONDS=900
# Optional: enables the Adzuna source (free key at https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# Anonymized title/skills/score logging used to retrain the matching encoder.
EVENTS_ENABLED=true
